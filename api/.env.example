# KAIROGEN_ACCESS_TOKEN=
# KAIROGEN_REFRESH_TOKEN=
# KAIROGEN_IMAGE_MODEL=gpt-image-2
# KAIROGEN_MODEL_PHOTO=flux-2-pro
# KAIROGEN_MODEL_COVER=gpt-image-2
# KAIROGEN_MODEL_VOLUME=gpt-image-2
# KAIROGEN_USE_IMAGE_REFS=true
# KAIROGEN_API_BASE=https://api.kairogen.ai
# Com refs + kairogen → nano-banana-pro (edit). Sem refs → modelo COVER.

# Research
APIFY_TOKEN=
# Actor padrao Instagram
APIFY_IG_ACTOR=apify/instagram-profile-scraper
# Ad Library comercial (BR) via scrape — substitui Graph Meta limitada
APIFY_AD_LIBRARY_ACTOR=viralanalyzer/facebook-ads-library
# Meta Graph (opcional / fallback; quase inutil para ads comerciais no BR)
META_ACCESS_TOKEN=
META_AD_LIBRARY_SEARCH_COUNTRY=BR

# Instagram publicar (conta do usuário no onboarding; fallback global opcional)
