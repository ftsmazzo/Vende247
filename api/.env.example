# Server
PORT=3000
HOST=0.0.0.0
JWT_SECRET=dev-mudar-em-producao

# Postgres (obrigatório em produção)
DATABASE_URL=postgresql://user:password@localhost:5432/vende247

# Cadastro aberto só no primeiro usuário; depois use:
# ALLOW_OPEN_REGISTER=true

# —— LLM: só OpenRouter (sem chave OpenAI/Anthropic/Gemini direta) ——
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=https://vendas247-painel.kxryyk.easypanel.host
OPENROUTER_APP_TITLE=Vende247
# Slug OpenRouter — troque quando quiser outro modelo:
LLM_MODEL=openai/gpt-4o-mini
# Opcional: modelo só do agente comentário/DM
# LLM_MODEL_AGENT=anthropic/claude-sonnet-4

# Imagem — preferir OpenRouter
IMAGE_PROVIDER=openrouter
OR_MODEL_DRAFT=krea/krea-2-medium-turbo
OR_MODEL_VOLUME=qwen/qwen-image-3
OR_MODEL_COVER=qwen/qwen-image-3-pro
OR_MODEL_PHOTO=krea/krea-2-large
