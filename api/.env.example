# Server
PORT=3000
HOST=0.0.0.0
JWT_SECRET=dev-mudar-em-producao

# Postgres (obrigatório em produção)
DATABASE_URL=postgresql://user:password@localhost:5432/vende247

# Cadastro aberto só no primeiro usuário; depois use:
# ALLOW_OPEN_REGISTER=true

# IA texto
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# openai | gemini | anthropic
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
# Alternativa barata: LLM_PROVIDER=openai + LLM_MODEL=gpt-4o-mini

# Imagem
IMAGE_PROVIDER=openai
# openai | gemini | openrouter
OPENAI_IMAGE_MODEL=gpt-image-1.5
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# OpenRouter (roteamento inteligente)
# OPENROUTER_API_KEY=
# IMAGE_PROVIDER=openrouter
# OR_MODEL_VOLUME=bytedance-seed/seedream-4.5
# OR_MODEL_COVER=google/gemini-3-pro-image
# OR_MODEL_PHOTO=black-forest-labs/flux.2-pro
# OR_MODEL_DRAFT=google/gemini-3.1-flash-image
# OR_RESOLUTION_VOLUME=2K
# OR_RESOLUTION_HQ=2K
# OPENROUTER_HTTP_REFERER=https://vendas247-painel.kxryyk.easypanel.host
# OPENROUTER_APP_TITLE=Vende247

# Research
APIFY_TOKEN=
# Actor padrão: apify/instagram-profile-scraper
APIFY_IG_ACTOR=apify/instagram-profile-scraper
# Meta Ad Library (Graph) — token com ads_read ou app token
META_ACCESS_TOKEN=
META_AD_LIBRARY_SEARCH_COUNTRY=BR

# Instagram publicar (conta do usuário no onboarding; fallback global opcional)
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_IG_USER_ID=

# Storage de mídia (Cloudinary unsigned preset ou local)
STORAGE=local
MEDIA_BASE_URL=http://localhost:3000
# STORAGE=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_UPLOAD_PRESET=
