# Server
PORT=3000
HOST=0.0.0.0
JWT_SECRET=dev-mudar-em-producao

# Postgres (obrigatório em produção)
DATABASE_URL=postgresql://user:password@localhost:5432/vende247

# Cadastro aberto só no primeiro usuário; depois use:
# ALLOW_OPEN_REGISTER=true

# IA texto
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# openai | gemini | anthropic
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
# Alternativa barata: LLM_PROVIDER=openai + LLM_MODEL=gpt-4o-mini

# Imagem — padrão: OpenAI gpt-image-2 (estável p/ criativos IG com texto)
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-2
# Feed 4:5 nativo no gpt-image-2 (1024x1280). Voltar: gpt-image-1.5
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# OpenRouter (custo):
# IMAGE_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OR_MODEL_DRAFT=krea/krea-2-medium-turbo
# OR_MODEL_VOLUME=qwen/qwen-image-3
# OR_MODEL_COVER=qwen/qwen-image-3-pro
# OR_MODEL_PHOTO=krea/krea-2-large
# OR_RESOLUTION_VOLUME=1K
# OR_RESOLUTION_HQ=2K
# OR_COMPARE_MODELS=krea/krea-2-medium-turbo,qwen/qwen-image-3,qwen/qwen-image-3-pro,krea/krea-2-large
# OPENROUTER_HTTP_REFERER=https://vendas247-painel.kxryyk.easypanel.host
# OPENROUTER_APP_TITLE=Vende247
# Kairogen (opcional — hub Flux/Banana/vídeo; NÃO necessário só p/ Image 2):
