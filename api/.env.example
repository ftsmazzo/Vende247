# Server
PORT=3000
HOST=0.0.0.0
JWT_SECRET=dev-mudar-em-producao

# Postgres (obrigatório em produção)
DATABASE_URL=postgresql://user:password@localhost:5432/vende247

# Cadastro aberto só no primeiro usuário; depois use:
# ALLOW_OPEN_REGISTER=true

# IA texto
OPENAI_API_KEY=
# ANTHROPIC não usado no MVP; OpenAI ou Gemini
GEMINI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Imagem
IMAGE_PROVIDER=openai
# gpt-image-1.5 (recomendado) — dall-e-3 costuma falhar em contas novas
OPENAI_IMAGE_MODEL=gpt-image-1.5
# Alternativa forte: IMAGE_PROVIDER=gemini + GEMINI_API_KEY (Imagen 4)

# Research
APIFY_TOKEN=
# Actor padrão: apify/instagram-profile-scraper
APIFY_IG_ACTOR=apify/instagram-profile-scraper
# Meta Ad Library (Graph) — token com ads_read ou app token
META_ACCESS_TOKEN=
META_AD_LIBRARY_SEARCH_COUNTRY=BR

# Instagram publicar (conta do usuário no onboarding; fallback global opcional)
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_IG_USER_ID=

# Storage de mídia (Cloudinary unsigned preset ou local)
STORAGE=local
MEDIA_BASE_URL=http://localhost:3000
# STORAGE=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_UPLOAD_PRESET=
